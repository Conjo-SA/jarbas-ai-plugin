{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce_delegation.mjs\""
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "mcp__jarbas__implement",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/record_delegation.mjs\""
                    }
                ]
            }
        ]
    }
}